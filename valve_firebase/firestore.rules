rules_version = '2';

// 밸브 조작 관리 - Firestore 보안 규칙
// 화면(앱)을 조작해도 서버에서 아래 규칙을 반드시 통과해야 저장됩니다.
//  - 등록된(사용중) 사용자만 읽기/쓰기
//  - 조작 등록은 본인 이름으로만, 확인(검증)은 '확인 권한'이 있고 조작자가 아닌 사람만
//  - 이력(events)은 추가만 가능, 수정 불가, 삭제는 관리자만
service cloud.firestore {
  match /databases/{db}/documents {

    function signedIn() { return request.auth != null; }
    function userPath(uid) { return /databases/$(db)/documents/users/$(uid); }
    function me() { return get(userPath(request.auth.uid)).data; }
    function isActive() {
      return signedIn() && exists(userPath(request.auth.uid)) && me().active == true;
    }
    function isAdmin() { return isActive() && me().role == 'admin'; }
    // 확인(검증) 권한: 관리자가 사용자 목록에서 지정한 사람(예: 운영부 팀장)만
    function canVerify() { return isActive() && me().get('canVerify', false) == true; }
    function isState(s) { return s == 'OPEN' || s == 'CLOSE'; }
    function onlyChanged(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // 최초 설정 여부 (관리자 계정이 만들어졌는지)
    match /meta/setup {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.adminUid == request.auth.uid
        && getAfter(userPath(request.auth.uid)).data.role == 'admin';
      allow update, delete: if false;
    }

    match /users/{uid} {
      function validUser() {
        let d = request.resource.data;
        return d.login is string && d.name is string && d.name.size() > 0
          && d.role in ['admin', 'user'] && d.active is bool && d.mustChangePw is bool
          && d.get('canVerify', false) is bool;
      }
      allow read: if isActive() || (signedIn() && request.auth.uid == uid);
      allow create: if (isAdmin() && validUser())
        // 최초 1회: 관리자 본인 등록 (meta/setup 과 함께 저장될 때만)
        || (signedIn() && uid == request.auth.uid && validUser()
            && !exists(/databases/$(db)/documents/meta/setup)
            && existsAfter(/databases/$(db)/documents/meta/setup)
            && request.resource.data.role == 'admin' && request.resource.data.active == true);
      allow update: if (isAdmin() && validUser()
            && request.resource.data.login == resource.data.login
            // 관리자는 자기 자신을 중지하거나 일반으로 내릴 수 없음
            && !(uid == request.auth.uid
                 && (request.resource.data.active != true || request.resource.data.role != 'admin')))
        // 본인: 비밀번호 변경 후 '변경 필요' 표시만 끌 수 있음
        || (signedIn() && uid == request.auth.uid
            && onlyChanged(['mustChangePw']) && request.resource.data.mustChangePw == false);
      allow delete: if isAdmin() && uid != request.auth.uid;   // 관리자: 다른 사용자 완전 삭제
    }

    // 아이디 → 로그인 주소 (로그인 화면에서 읽음, 관리자만 기록)
    match /logins/{login} {
      allow read: if true;
      allow create, update: if isAdmin() && request.resource.data.keys().hasOnly(['email', 'uid'])
        && request.resource.data.email is string;
      allow delete: if isAdmin();
    }

    // 사용자 비밀번호 보관함: 관리자만 읽기/삭제, 쓰기는 관리자 또는 본인(비밀번호 변경 시)
    match /userSecrets/{uid} {
      allow read, delete: if isAdmin();
      allow create, update: if (isAdmin() || (signedIn() && uid == request.auth.uid))
        && request.resource.data.keys().hasOnly(['pw', 'login'])
        && request.resource.data.pw is string && request.resource.data.pw.size() >= 6;
    }

    match /valves/{vid} {
      // 현장 조작 등록
      function isOperate() {
        let d = request.resource.data;
        return isActive() && resource.data.active == true
          && onlyChanged(['current', 'status', 'operatedBy', 'operatedById', 'operatedAt',
                          'verifiedBy', 'verifiedById', 'verifiedAt', 'rev'])
          && isState(d.current) && d.status == '확인대기'
          && d.operatedById == request.auth.uid && d.operatedBy == me().name
          && d.operatedAt == request.time
          && d.verifiedBy == '' && d.verifiedById == '' && d.verifiedAt == null
          && d.rev == resource.data.rev + 1;
      }
      // 확인(검증): 확인 권한이 있고, 조작한 사람과 다른 사람만
      function isVerify() {
        let d = request.resource.data;
        return canVerify() && resource.data.active == true
          && onlyChanged(['status', 'verifiedBy', 'verifiedById', 'verifiedAt', 'rev'])
          && resource.data.status in ['확인대기', '불일치']
          && d.status in ['확인완료', '불일치']
          && resource.data.operatedById != request.auth.uid
          && d.verifiedById == request.auth.uid && d.verifiedBy == me().name
          && d.verifiedAt == request.time
          && d.rev == resource.data.rev + 1;
      }
      // 엑셀의 '밸브현재상태' 반영: 관리자 이름으로 조작 등록한 것과 같음 → 확인 필요
      function isExcelState(d) {
        return isState(d.current) && d.status == '확인대기'
          && d.operatedById == request.auth.uid && d.operatedAt == request.time
          && d.verifiedBy == '' && d.verifiedById == '' && d.verifiedAt == null;
      }
      // 관리자: 정보 수정/숨김(조작·확인 기록은 못 바꿈), '미조작'으로 초기화, 또는 엑셀 현재상태 반영
      function isAdminEdit() {
        let d = request.resource.data;
        let r = resource.data;
        return isAdmin() && d.rev == r.rev + 1 && d.tag is string && d.tag.size() > 0 && (
          (d.status == r.status && d.current == r.current
            && d.operatedBy == r.operatedBy && d.operatedById == r.operatedById
            && d.operatedAt == r.operatedAt && d.verifiedBy == r.verifiedBy
            && d.verifiedById == r.verifiedById && d.verifiedAt == r.verifiedAt)
          || (d.status == '미조작' && d.current == '미확인'
            && d.operatedById == '' && d.verifiedById == '')
          || isExcelState(d));
      }
      allow read: if isActive();
      allow create: if isAdmin()
        && request.resource.data.tag is string && request.resource.data.tag.size() > 0
        && ((request.resource.data.status == '미조작' && request.resource.data.current == '미확인')
            || isExcelState(request.resource.data))
        && request.resource.data.rev == 0 && request.resource.data.active == true;
      // 사진 추가 시 목록의 📷 개수만 1 올림
      function isPhotoCount() {
        return isActive() && resource.data.active == true && onlyChanged(['photoCount'])
          && request.resource.data.photoCount == resource.data.get('photoCount', 0) + 1;
      }
      allow update: if isOperate() || isVerify() || isAdminEdit() || isPhotoCount();
      allow delete: if false;
    }

    match /events/{eid} {
      function valvePath() { return /databases/$(db)/documents/valves/$(request.resource.data.valveId); }
      allow read: if isActive();
      allow create: if isActive()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.userName == me().name
        && request.resource.data.ts == request.time
        && (
          // 조작/확인 이력: 같은 요청에서 해당 밸브가 실제로 바뀐 경우에만
          (request.resource.data.kind in ['조작', '확인', '불일치']
            && get(valvePath()).data.rev + 1 == request.resource.data.rev
            && getAfter(valvePath()).data.rev == request.resource.data.rev)
          || (isAdmin() && request.resource.data.kind in ['등록', '수정', '초기화', '숨김', '엑셀반영', '수기반영'])
          || (request.resource.data.kind == '사진'
            && exists(/databases/$(db)/documents/photos/$(request.resource.data.photoId))
              == false && existsAfter(/databases/$(db)/documents/photos/$(request.resource.data.photoId))));
      allow update: if false;
      allow delete: if isAdmin();   // 이력 삭제는 관리자만
    }

    // 현장 사진 (압축한 사진을 문서에 직접 저장 - 무료 요금제에서 사용 가능)
    match /photos/{pid} {
      allow read: if isActive();
      allow create: if isActive()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.userName == me().name
        && request.resource.data.ts == request.time
        && request.resource.data.valveId is string
        && request.resource.data.thumb is string
        && request.resource.data.thumb.size() < 100000;
      allow update: if false;
      allow delete: if isAdmin();
    }
    // 원본 크기 사진 (목록에는 작은 사진만, 눌렀을 때만 이걸 읽음)
    match /photoFull/{pid} {
      allow read: if isActive();
      allow create: if isActive()
        && request.resource.data.userId == request.auth.uid
        && getAfter(/databases/$(db)/documents/photos/$(pid)).data.userId == request.auth.uid
        && request.resource.data.data is string
        && request.resource.data.data.size() < 1000000;
      allow update: if false;
      allow delete: if isAdmin();
    }
  }
}
